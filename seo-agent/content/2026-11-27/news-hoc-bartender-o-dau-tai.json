                  "detail": 0,
                  "mode": "normal",
                  "style": "",
                  "version": 1
                }
              ]
            },
            {
              "type": "text",
              "text": ". Ở chỗ khác, cứ hỏi người dạy mình hiện đang làm ở đâu.",
              "format": 0,
              "detail": 0,
              "mode": "normal",
