                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": "",
                      "version": 1
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ", tập trung vào mixology, xây dựng menu và quản lý chi phí.",
                  "format": 0,
                  "detail": 0,
                  "mode": "normal",
                  "style": "",
                  "version": 1
                }
              ]
            },
            {
              "direction": "ltr",
              "format": "",
              "indent": 0,
              "version": 1,
              "type": "listitem",
              "value": 3,
              "children": [
                {
                  "type": "text",
