                      "style": "",
                      "version": 1
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ", học từ dụng cụ, kỹ thuật nền tảng đến quy trình vận hành quầy.",
                  "format": 0,
                  "detail": 0,
                  "mode": "normal",
                  "style": "",
                  "version": 1
                }
              ]
            },
            {
              "direction": "ltr",
              "format": "",
              "indent": 0,
              "version": 1,
              "type": "listitem",
              "value": 2,
              "children": [
                {
                  "type": "text",
                  "text": "Đã có nền tảng và muốn phát triển lên vị trí cao hơn: ",
                  "format": 0,
                  "detail": 0,
                  "mode": "normal",
                  "style": "",
