                  "fields": {
                    "linkType": "custom",
                    "url": "/courses/mot-kem-mot",
                    "newTab": false
                  },
                  "children": [
                    {
                      "type": "text",
                      "text": "Học 1 kèm 1",
                      "format": 0,
                      "detail": 0,
                      "mode": "normal",
                      "style": "",
                      "version": 1
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ": thời lượng xây dựng theo mục tiêu và lịch học của từng học viên.",
                  "format": 0,
                  "detail": 0,
                  "mode": "normal",
                  "style": "",
                  "version": 1
                }
              ]
            }
          ]
        },
        {
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "version": 1,
          "type": "paragraph",
          "textFormat": 0,
          "children": [
            {
              "type": "text",
              "text": "Đối với người mới, lộ trình phổ biến là hoàn thành khóa cơ bản trước, sau đó lựa chọn khóa nâng cao hoặc các khóa chuyên đề tùy theo định hướng phát triển.",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            }
          ]
        },
        {
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "version": 1,
          "type": "heading",
          "tag": "h2",
          "children": [
            {
              "type": "text",
              "text": "Các yếu tố quyết định thời gian học",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            }
          ]
        },
        {
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "version": 1,
          "type": "heading",
          "tag": "h3",
          "children": [
            {
              "type": "text",
              "text": "Mục tiêu nghề nghiệp",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            }
          ]
        },
        {
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "version": 1,
          "type": "paragraph",
          "textFormat": 0,
          "children": [
            {
              "type": "text",
              "text": "Nếu bạn học pha chế để phục vụ nhu cầu cá nhân hoặc hỗ trợ công việc kinh doanh của gia đình, khóa cơ bản đã cung cấp đủ kiến thức và kỹ năng cần thiết. Nếu bạn hướng đến việc làm bartender chuyên nghiệp, xây dựng menu hoặc phát triển lên vị trí head bartender, bạn sẽ cần thêm thời gian cho các nội dung nâng cao và tích lũy nhiều giờ làm việc thực tế.",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            }
          ]
        },
        {
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "version": 1,
          "type": "heading",
          "tag": "h3",
          "children": [
            {
              "type": "text",
              "text": "Nền tảng ban đầu",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            }
          ]
        },
        {
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "version": 1,
          "type": "paragraph",
          "textFormat": 0,
          "children": [
            {
              "type": "text",
              "text": "Người đã từng làm phục vụ hoặc làm việc tại quán cà phê thường thích nghi nhanh hơn với nhịp độ làm việc sau quầy. Người chưa từng tiếp xúc với nghề sẽ cần một số buổi đầu để làm quen với dụng cụ, thao tác và tên gọi nguyên liệu. Cả hai nhóm đều có thể đạt được kết quả tốt; điểm khác biệt chỉ nằm ở thời gian thích nghi ban đầu.",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            }
          ]
        },
        {
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "version": 1,
          "type": "heading",
          "tag": "h3",
          "children": [
            {
              "type": "text",
              "text": "Mức độ luyện tập ngoài giờ học",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            }
          ]
        },
        {
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "version": 1,
          "type": "paragraph",
          "textFormat": 0,
          "children": [
            {
              "type": "text",
              "text": "Đây là yếu tố tạo ra khác biệt lớn nhất. Học viên duy trì luyện tập đều đặn giữa các buổi học, chẳng hạn luyện đong bằng jigger hoặc luyện thao tác lắc với nước, thường tiến bộ nhanh hơn rõ rệt so với học viên chỉ thực hành trong giờ học.",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            }
          ]
        },
        {
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "version": 1,
          "type": "heading",
          "tag": "h2",
          "children": [
            {
              "type": "text",
              "text": "Lộ trình học bartender theo từng giai đoạn",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            }
          ]
        },
        {
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "version": 1,
          "type": "heading",
          "tag": "h3",
          "children": [
            {
              "type": "text",
              "text": "Giai đoạn 1: Xây dựng nền tảng (2 tháng)",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            }
          ]
        },
        {
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "version": 1,
          "type": "paragraph",
          "textFormat": 0,
          "children": [
            {
              "type": "text",
              "text": "Đây là giai đoạn quan trọng nhất. Học viên làm quen với dụng cụ quầy bar, các kỹ thuật shake, stir, build, muddle, kiến thức về các dòng rượu nền và quy trình vận hành một quầy bar từ lúc mở quầy đến khi đóng quầy. Mỗi lớp có tối đa 6 học viên, giúp giảng viên theo sát thao tác của từng người. Thông tin chi tiết được trình bày tại trang ",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            },
            {
              "direction": "ltr",
              "format": "",
              "indent": 0,
              "version": 3,
              "type": "link",
              "fields": {
                "linkType": "custom",
                "url": "/courses/bartender-co-ban",
                "newTab": false
              },
              "children": [
                {
                  "type": "text",
                  "text": "khóa học bartender cơ bản TP.HCM",
                  "format": 0,
                  "detail": 0,
                  "mode": "normal",
                  "style": "",
                  "version": 1
                }
              ]
            },
            {
              "type": "text",
              "text": ".",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            }
          ]
        },
        {
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "version": 1,
          "type": "heading",
          "tag": "h3",
          "children": [
            {
              "type": "text",
              "text": "Giai đoạn 2: Nâng cao chuyên môn (6 tuần)",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            }
          ]
        },
        {
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "version": 1,
          "type": "paragraph",
          "textFormat": 0,
          "children": [
            {
              "type": "text",
              "text": "Sau khi đã có nền tảng vững vàng, học viên có thể tiếp tục với khóa nâng cao để tìm hiểu sâu hơn về mixology, các kỹ thuật như infusion và smoke, phương pháp xây dựng menu cocktail signature, cùng các kỹ năng quản lý như tính giá vốn và kiểm soát chi phí quầy bar.",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            }
          ]
        },
        {
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "version": 1,
          "type": "heading",
          "tag": "h3",
          "children": [
            {
              "type": "text",
              "text": "Giai đoạn 3: Chuyên đề theo định hướng (8 buổi)",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            }
          ]
        },
        {
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "version": 1,
          "type": "paragraph",
          "textFormat": 0,
          "children": [
            {
              "type": "text",
              "text": "Tùy theo định hướng phát triển, học viên có thể lựa chọn Flair Bartending nếu quan tâm đến phong cách biểu diễn, hoặc Bar Skill nếu muốn rèn luyện tốc độ, độ chính xác và sự gọn gàng khi làm việc trong giờ cao điểm.",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            }
          ]
        },
        {
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "version": 1,
          "type": "heading",
          "tag": "h2",
          "children": [
            {
              "type": "text",
              "text": "Giải pháp cho người có lịch học hạn chế",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            }
          ]
        },
        {
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "version": 1,
          "type": "paragraph",
          "textFormat": 0,
          "children": [
            {
              "type": "text",
              "text": "Không phải học viên nào cũng có thể theo một lịch học cố định, đặc biệt là người đang đi làm theo giờ hành chính hoặc làm việc theo ca. Đối với những trường hợp này, ",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            },
            {
              "direction": "ltr",
              "format": "",
              "indent": 0,
              "version": 3,
              "type": "link",
              "fields": {
                "linkType": "custom",
                "url": "/courses/mot-kem-mot",
                "newTab": false
              },
              "children": [
                {
                  "type": "text",
                  "text": "hình thức học 1 kèm 1",
                  "format": 0,
                  "detail": 0,
                  "mode": "normal",
                  "style": "",
                  "version": 1
                }
              ]
            },
            {
              "type": "text",
              "text": " là lựa chọn phù hợp. Ở buổi đầu tiên, giảng viên đánh giá trình độ hiện tại của học viên, sau đó hai bên cùng xây dựng nội dung và lịch học riêng.",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            }
          ]
        },
        {
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "version": 1,
          "type": "heading",
          "tag": "h2",
          "children": [
            {
              "type": "text",
              "text": "Hoàn thành khóa học đã có thể đi làm chưa",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            }
          ]
        },
        {
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "version": 1,
          "type": "paragraph",
          "textFormat": 0,
          "children": [
            {
              "type": "text",
              "text": "Sau khi hoàn thành khóa cơ bản, học viên có đủ kiến thức và kỹ năng để ứng tuyển vị trí barback hoặc bartender tại nhiều quán bar. Tuy nhiên, sự thành thạo thực sự được hình thành qua quá trình làm việc thực tế sau đó. Giảng viên của Skill & Mix là những bartender đang làm việc trong ngành Beverage & Hospitality, vì vậy học viên được tiếp cận với cách vận hành thực tế của một quầy bar ngay trong quá trình học. Sau khóa học, trung tâm hỗ trợ kết nối việc làm cho học viên có nhu cầu.",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            }
          ]
        },
        {
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "version": 1,
          "type": "heading",
          "tag": "h2",
          "children": [
            {
              "type": "text",
              "text": "Gợi ý lựa chọn thời lượng học phù hợp",
              "format": 0,
              "detail": 0,
              "mode": "normal",
              "style": "",
              "version": 1
            }
          ]
        },
        {
          "direction": "ltr",
          "format": "",
          "indent": 0,
          "version": 1,
          "type": "list",
          "listType": "bullet",
          "tag": "ul",
          "start": 1,
          "children": [
            {
              "direction": "ltr",
              "format": "",
              "indent": 0,
              "version": 1,
              "type": "listitem",
              "value": 1,
              "children": [
                {
                  "type": "text",
                  "text": "Chưa có kinh nghiệm pha chế: bắt đầu với khóa cơ bản.",
                  "format": 0,
                  "detail": 0,
                  "mode": "normal",
                  "style": "",
                  "version": 1
                }
              ]
            },
            {
              "direction": "ltr",
              "format": "",
              "indent": 0,
              "version": 1,
              "type": "listitem",
              "value": 2,
              "children": [
                {
                  "type": "text",
                  "text": "Đã có nền tảng và muốn làm việc chuyên nghiệp: cân nhắc khóa nâng cao sau khi đã vững kiến thức cơ bản.",
                  "format": 0,
                  "detail": 0,
                  "mode": "normal",
                  "style": "",
                  "version": 1
                }
              ]
            },
            {
              "direction": "ltr",
